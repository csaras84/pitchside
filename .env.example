# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
# Everything is optional: with no keys set, Pitchside runs fully offline using
# deterministic template agents, so the demo never breaks.

# Microsoft Foundry / Azure OpenAI deployment used by the Narrator agent.
# Endpoint: the resource host, e.g. https://<resource>.services.ai.azure.com (a copied Target URI is fine).
# Deployment: the deployment NAME shown in the Foundry portal (not necessarily the model name).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Azure AI Translator (multilingual captions / audio description)
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# Public-demo guardrails (optional; these are the defaults).
# Uncached requests allowed per client per minute (soft limit).
PITCHSIDE_RATE_PER_MIN=30
# Runs per hour allowed to call Foundry / Translator. Past this the app answers with the
# offline template agents instead of refusing anyone.
PITCHSIDE_CLOUD_RUNS_PER_HOUR=200
# Recent results kept in memory; repeats of the same request are free.
PITCHSIDE_CACHE_SIZE=256
