# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
# Everything is optional: with no keys set, Pitchside runs fully offline using
# deterministic template agents, so the demo never breaks.

# Microsoft Foundry / Azure OpenAI deployment used by the Narrator agent
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Azure AI Translator (multilingual captions / audio description)
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
